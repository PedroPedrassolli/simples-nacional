    {
      "titulo": "Anexo",
      "texto": "Revenda de mercadorias: Anexo I (Comércio).",
      "fonte": "LC 123/2006, art. 18, § 4º, I, e Anexo I",
      "grupo": "Receita 1: Revenda de mercadorias"
    },
    {
      "titulo": "Faixa",
      "texto": "A RBT12 é de R$ 500.000,00 e fica na 3ª faixa do Anexo I, de R$ 360.000,01 a R$ 720.000,00: alíquota nominal de 9,50% e parcela a deduzir de R$ 13.860,00.",
      "fonte": "LC 123/2006, art. 18, § 1º, e Anexo I",
      "grupo": "Receita 1: Revenda de mercadorias"
    },
    {
      "titulo": "Alíquota efetiva",
      "texto": "(RBT12 × alíquota nominal − parcela a deduzir) ÷ RBT12 = (R$ 500.000,00 × 9,50% − R$ 13.860,00) ÷ R$ 500.000,00 = 6,7280%.",
      "fonte": "LC 123/2006, art. 18, § 1º-A",
      "grupo": "Receita 1: Revenda de mercadorias"
    },
    {
      "titulo": "Divisão entre os tributos",
      "texto": "A alíquota efetiva é dividida entre os tributos pelos percentuais da 3ª faixa do Anexo I: IRPJ 5,50%, CSLL 3,50%, Cofins 12,74%, PIS/Pasep 2,76%, CPP 42,00% e ICMS 33,50%. Por exemplo, IRPJ = 6,7280% × 5,50% = 0,3700%.",
      "fonte": "Res. CGSN 140/2018, art. 21, III; LC 123/2006, Anexo I",
      "grupo": "Receita 1: Revenda de mercadorias"
    },
    {
      "titulo": "O que esta receita não paga no DAS",
      "texto": "Saem da conta: o ICMS (já pago por substituição tributária ou antecipação). Soma dos percentuais desta receita: 4,4741%.",
      "fonte": "LC 123/2006, art. 18, § 4º-A, I; Res. CGSN 140/2018, art. 25, § 8º",
      "grupo": "Receita 1: Revenda de mercadorias"
    },
    {
      "titulo": "Valor desta receita",
      "texto": "Receita × soma dos percentuais = R$ 30.000,00 × 4,4741% = R$ 1.342,24.",
      "fonte": "LC 123/2006, art. 18, § 3º",
      "grupo": "Receita 1: Revenda de mercadorias"
    },
    {
      "titulo": "Anexo",
      "texto": "Serviços do Anexo III: Anexo III (Locação de bens móveis e serviços não relacionados no § 5º-C do art. 18).",
