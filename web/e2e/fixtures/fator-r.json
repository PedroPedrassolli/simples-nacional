    {
      "titulo": "Fator R",
      "texto": "Folha de salários ÷ RBT12 = R$ 139.999,99 ÷ R$ 500.000,00 = 27,99%. Como é menor que 28%, a atividade vai para o Anexo V: Serviços relacionados no § 5º-I do art. 18.",
      "fonte": "LC 123/2006, art. 18, §§ 5º-J, 5º-K, 5º-M e 24"
    },
    {
      "titulo": "Faixa",
      "texto": "A RBT12 é de R$ 500.000,00 e fica na 3ª faixa do Anexo V, de R$ 360.000,01 a R$ 720.000,00: alíquota nominal de 19,50% e parcela a deduzir de R$ 9.900,00.",
      "fonte": "LC 123/2006, art. 18, § 1º, e Anexo V"
    },
    {
      "titulo": "Alíquota efetiva",
      "texto": "(RBT12 × alíquota nominal − parcela a deduzir) ÷ RBT12 = (R$ 500.000,00 × 19,50% − R$ 9.900,00) ÷ R$ 500.000,00 = 17,5200%.",
      "fonte": "LC 123/2006, art. 18, § 1º-A"
    },
    {
      "titulo": "Divisão entre os tributos",
      "texto": "A alíquota efetiva é dividida entre os tributos pelos percentuais da 3ª faixa do Anexo V: IRPJ 24,00%, CSLL 15,00%, Cofins 14,92%, PIS/Pasep 3,23%, CPP 23,85% e ISS 19,00%. Por exemplo, IRPJ = 17,5200% × 24,00% = 4,2048%.",
      "fonte": "Res. CGSN 140/2018, art. 21, III; LC 123/2006, Anexo V"
    },
    {
      "titulo": "DAS estimado",
      "texto": "Receita do mês × alíquota efetiva = R$ 40.000,00 × 17,5200% = R$ 7.008,00. A conta usa os percentuais exatos, sem cortar casas decimais, e arredonda o resultado para o centavo.",
      "fonte": "LC 123/2006, art. 18, § 3º"
    }
