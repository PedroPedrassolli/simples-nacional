    {
      "titulo": "Anexo",
      "texto": "Serviços do Anexo III: Anexo III (Locação de bens móveis e serviços não relacionados no § 5º-C do art. 18).",
      "fonte": "LC 123/2006, art. 18, § 4º, III, e § 5º-B, e Anexo III",
      "grupo": "Receita do mês"
    },
    {
      "titulo": "Faixa",
      "texto": "A RBT12 é de R$ 500.000,00 e fica na 3ª faixa do Anexo III, de R$ 360.000,01 a R$ 720.000,00: alíquota nominal de 13,50% e parcela a deduzir de R$ 17.640,00.",
      "fonte": "LC 123/2006, art. 18, § 1º, e Anexo III",
      "grupo": "Receita do mês"
    },
    {
      "titulo": "Alíquota efetiva",
      "texto": "(RBT12 × alíquota nominal − parcela a deduzir) ÷ RBT12 = (R$ 500.000,00 × 13,50% − R$ 17.640,00) ÷ R$ 500.000,00 = 9,9720%.",
      "fonte": "LC 123/2006, art. 18, § 1º-A",
      "grupo": "Receita do mês"
    },
    {
      "titulo": "Divisão entre os tributos",
      "texto": "A alíquota efetiva é dividida entre os tributos pelos percentuais da 3ª faixa do Anexo III: IRPJ 4,00%, CSLL 3,50%, Cofins 13,64%, PIS/Pasep 2,96%, CPP 43,40% e ISS 32,50%. Por exemplo, IRPJ = 9,9720% × 4,00% = 0,3988%.",
      "fonte": "Res. CGSN 140/2018, art. 21, III; LC 123/2006, Anexo III",
      "grupo": "Receita do mês"
    },
    {
      "titulo": "DAS estimado",
      "texto": "Receita do mês × alíquota efetiva = R$ 40.000,00 × 9,9720% = R$ 3.988,80. A conta usa os percentuais exatos, sem cortar casas decimais, e arredonda o resultado para o centavo.",
      "fonte": "LC 123/2006, art. 18, § 3º",
      "grupo": "Total do mês"
    }
