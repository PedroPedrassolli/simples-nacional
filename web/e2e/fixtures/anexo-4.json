  "passos": [
    {
      "titulo": "Anexo",
      "texto": "Serviços do Anexo IV (obras, limpeza, vigilância, advocacia): Anexo IV (Serviços relacionados no § 5º-C do art. 18).",
      "fonte": "LC 123/2006, art. 18, § 4º, IV, e § 5º-C, e Anexo IV",
      "grupo": "Receita do mês"
    },
    {
      "titulo": "Faixa",
      "texto": "A RBT12 é de R$ 500.000,00 e fica na 3ª faixa do Anexo IV, de R$ 360.000,01 a R$ 720.000,00: alíquota nominal de 10,20% e parcela a deduzir de R$ 12.420,00.",
      "fonte": "LC 123/2006, art. 18, § 1º, e Anexo IV",
      "grupo": "Receita do mês"
    },
    {
      "titulo": "Alíquota efetiva",
      "texto": "(RBT12 × alíquota nominal − parcela a deduzir) ÷ RBT12 = (R$ 500.000,00 × 10,20% − R$ 12.420,00) ÷ R$ 500.000,00 = 7,7160%.",
      "fonte": "LC 123/2006, art. 18, § 1º-A",
      "grupo": "Receita do mês"
    },
    {
      "titulo": "Divisão entre os tributos",
      "texto": "A alíquota efetiva é dividida entre os tributos pelos percentuais da 3ª faixa do Anexo IV: IRPJ 20,80%, CSLL 15,20%, Cofins 19,73%, PIS/Pasep 4,27% e ISS 40,00%. Por exemplo, IRPJ = 7,7160% × 20,80% = 1,6049%. No Anexo IV, a contribuição patronal ao INSS (CPP) não entra no DAS: é paga à parte, como nas outras empresas.",
      "fonte": "Res. CGSN 140/2018, art. 21, III; LC 123/2006, Anexo IV e art. 13, VI",
      "grupo": "Receita do mês"
    },
    {
      "titulo": "CPP fora do DAS",
      "texto": "No Anexo IV, a contribuição patronal ao INSS (CPP) não entra no DAS. Estimativa: R$ 30.000,00 × (20% + 2% × FAP 1,5000) + R$ 5.000,00 de pró-labore × 20% = R$ 7.900,00.",
      "fonte": "LC 123/2006, art. 18, § 5º-C; Lei 8.212/1991, art. 22, I a III; Lei 10.666/2003, art. 10",
      "grupo": "Fora do DAS"
    },
    {
      "titulo": "DAS estimado",
      "texto": "Receita do mês × alíquota efetiva = R$ 40.000,00 × 7,7160% = R$ 3.086,40. A conta usa os percentuais exatos, sem cortar casas decimais, e arredonda o resultado para o centavo.",
      "fonte": "LC 123/2006, art. 18, § 3º",
      "grupo": "Total do mês"
    }
