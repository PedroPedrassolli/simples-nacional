{
  "name": "simples-nacional-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/prerender.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.js\"",
    "test:e2e": "playwright test",
    "format": "prettier --write . ../vercel.json",
    "format:check": "prettier --check . ../vercel.json"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.6.0",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": "24.x"
  }
}
